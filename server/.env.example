PORT=5001
NODE_ENV=development

# Local development
MONGO_URI=mongodb://127.0.0.1:27017/EthixPortal

# MongoDB Atlas (copy the full connection string from Atlas → Connect → Drivers)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# Comma-separated list; common Vite ports are also allowed automatically in development
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174
